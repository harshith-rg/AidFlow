# Copy this file to .env and fill in your own values. NEVER commit .env.
NODE_ENV=development
PORT=4000

# Local PostgreSQL (create the database first: createdb aidflow)
DATABASE_URL=postgresql://postgres:xyz123@localhost:5432/aidflow
DATABASE_URL_TEST=postgresql://postgres:xyz123@localhost:5432/aidflow_test

# Vite dev server address (comma-separate to allow several origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Dispatch: how long a driver has to respond (server-enforced)
DISPATCH_TIMEOUT_MS=20000
DISPATCH_RADIUS_KM=50
DISPATCH_RETRY_MS=30000
DISPATCH_MAX_RETRIES=5
LOCATION_STALE_SECONDS=120
HOSPITAL_STALE_HOURS=24

# Routing
ROUTING_PROVIDER=graph
ROUTING_SPEED_KMH=35
OSRM_URL=
ORS_API_KEY=
PYTHON_ROUTING_URL=http://localhost:8000

# Simulation & Telephony
SIMULATION_ENABLED=true
TELEPHONY_PROVIDER=simulated
HELPLINE_DEMO_NUMBER=1800-000-0000
CALL_RING_TIMEOUT_MS=30000

# JWT Auth (min 16 characters required)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# Password given to the demo users created by db:seed (demo data only)
SEED_DEMO_PASSWORD=ChangeMe123!

LOG_LEVEL=info

# AI intake: rules works offline; llm is optional and requires LLM_API_URL + LLM_API_KEY
AI_EXTRACTOR=rules
TRIAGE_SERVICE_URL=http://127.0.0.1:8100
