{
  "name": "aidflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -k \"npm run dev:user\" \"npm run dev:control\" \"npm --prefix backend run dev\"",
    "dev:full": "concurrently -k \"npm run dev:user\" \"npm run dev:control\" \"npm --prefix backend run dev\" \"npm run dev:python\"",
    "dev:python": "uvicorn app.main:app --port 8000 --reload",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit && npm --prefix backend run typecheck",
    "test": "npm --prefix backend test",
    "dev:user": "vite --config vite.user.config.ts --host 0.0.0.0 --strictPort",
    "dev:control": "vite --config vite.control.config.ts --host 0.0.0.0 --strictPort"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.6",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
